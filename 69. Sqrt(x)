class Solution {
public:
    int mySqrt(int x) {
        
        int low=1,high=x;
        long long mid;
        while(low<=high)
        {
            mid=low+(high-low)/2;
            long long square=mid*mid;
            if(square==x)
            {
                return mid;
            }
            else if(square<x)
            {
                low=mid+1;
            }
            else
            high=mid-1;
        }
        return high;
        
    }
};
